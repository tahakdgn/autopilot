#!/bin/bash
#
# autopilot-forever - keep run.sh working until the task is actually done.
#
# run.sh stops after its max iterations, and burns through them instantly when
# Claude's usage limit is hit. This restarts it, and sleeps through the limit --
# registering a WakeToRun scheduled task so a sleeping PC wakes for the reset.
#
# run.sh keeps the terminal, so Claude's session stays watchable. Progress is
# read from the task JSON (ground truth), and the usage limit is confirmed with
# one cheap `claude -p` probe instead of scraping the session output.
#
# Usage:  autopilot-forever <taskfile.json> [run.sh options]
#         autopilot-forever /my-command --max 5
#         autopilot-forever                        # queue mode
#
# Env:  AUTOPILOT_RETRY  fallback wait when no reset time is printed (default 900)
#       AUTOPILOT_DELAY  seconds between restarts                    (default 10)
#       AUTOPILOT_NOWAKE 1 = never touch the Windows scheduler
#       AUTOPILOT_NOPTY  1 = do not wrap run.sh in winpty
#       AUTOPILOT_NO_UNSTICK  1 = donan session bekcisini calistirma
#       AUTOPILOT_RUN_SH path to run.sh                (default ~/autopilot/run.sh)
#       AUTOPILOT_CLAUDE claude binary used for the limit probe    (default claude)
#       AUTOPILOT_LOG    wrapper log     (default ~/.claude/autopilot-forever.log)
#
# Stops when the task file has nothing left, or on Ctrl-C.

set -u

RUN="${AUTOPILOT_RUN_SH:-$HOME/autopilot/run.sh}"
LOG="${AUTOPILOT_LOG:-$HOME/.claude/autopilot-forever.log}"
CLAUDE_BIN="${AUTOPILOT_CLAUDE:-claude}"
RETRY="${AUTOPILOT_RETRY:-900}"
DELAY="${AUTOPILOT_DELAY:-10}"
WAKE_TASK="AutopilotWake"

say() { echo "$*"; echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG"; }

# Claude is node.exe, a native console app, and Git Bash hands it an MSYS pty it
# cannot draw on -- the terminal just stays black. winpty bridges the two. It
# needs real ttys on both ends, which is why nothing here may be piped.
RUNNER=(bash)
if [[ "${AUTOPILOT_NOPTY:-0}" != "1" && -t 0 && -t 1 ]] && command -v winpty >/dev/null 2>&1; then
    RUNNER=(winpty bash)
fi

# Unfinished requirements in a task file. Prints nothing if it can't tell.
remaining_count() {
    local f="$1"
    [[ -f "$f" ]] || return 1
    if command -v jq >/dev/null 2>&1; then
        jq '[.. | objects | select(has("passes"))
             | select(.passes != true and .stuck != true and .invalidTest != true)]
            | length' "$f" 2>/dev/null
    else
        python -c 'import json,sys
a=[]
def w(o):
    if isinstance(o,dict):
        if "passes" in o: a.append(o)
        for v in o.values(): w(v)
    elif isinstance(o,list):
        for v in o: w(v)
w(json.load(open(sys.argv[1],encoding="utf-8")))
print(sum(1 for x in a if not x.get("passes") and not x.get("stuck") and not x.get("invalidTest")))' "$f" 2>/dev/null
    fi
}

# Path of the next runnable queue entry, empty when the queue is drained.
# Queue mode (no task file argument) leans on autopilot's own derived status.
queue_next() {
    command -v autopilot-queue >/dev/null 2>&1 || return 1
    local out
    out=$(autopilot-queue next 2>/dev/null | tr -d '
' | head -1) || return 1
    [[ -f "$out" ]] || return 1
    echo "$out"
}

# One throwaway prompt: the cheapest way to ask "are we rate limited?" without
# reading the session's own output, which has to stay on the terminal.
limit_probe() {
    "$CLAUDE_BIN" -p 'ok' 2>&1 | head -20 \
        | grep -iE 'usage limit|limit reached|resets at|rate.?limit|too many requests' | head -1
}

# Epoch of the reset time in a limit message, e.g. "resets at 3pm" / "resets 15:00".
reset_epoch() {
    local txt hh mm ap target
    txt=$(grep -oiE 'resets?( at)? [0-9]{1,2}(:[0-9]{2})? ?(am|pm)?' <<<"$1" | head -1)
    [[ -n "$txt" ]] || return 1
    hh=$(grep -oE '[0-9]{1,2}' <<<"$txt" | head -1)
    mm=$(grep -oE ':[0-9]{2}' <<<"$txt" | head -1 | tr -d ':')
    ap=$(grep -oiE 'am|pm' <<<"$txt" | head -1 | tr 'A-Z' 'a-z')
    hh=$((10#$hh)); mm=$((10#${mm:-0}))
    [[ "$ap" == "pm" && "$hh" -lt 12 ]] && hh=$((hh + 12))
    [[ "$ap" == "am" && "$hh" -eq 12 ]] && hh=0
    target=$(date -d "today $(printf '%02d:%02d' "$hh" "$mm")" +%s 2>/dev/null) || return 1
    [[ "$target" -le "$(date +%s)" ]] && target=$((target + 86400))
    echo "$target"
}

# One-shot task whose only job is -WakeToRun: it wakes the box, the sleep below
# returns, and the loop retries. Nothing is relaunched.
schedule_wake() {
    [[ "${AUTOPILOT_NOWAKE:-0}" == "1" ]] && return 0
    command -v powershell.exe >/dev/null 2>&1 || return 0
    local at; at=$(date -d "@$1" +%Y-%m-%dT%H:%M:%S) || return 0
    powershell.exe -NoProfile -NonInteractive -Command "
        \$t = New-ScheduledTaskTrigger -Once -At '$at'
        \$s = New-ScheduledTaskSettingsSet -WakeToRun -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries
        \$a = New-ScheduledTaskAction -Execute 'cmd.exe' -Argument '/c exit'
        Register-ScheduledTask -TaskName '$WAKE_TASK' -Trigger \$t -Settings \$s -Action \$a -Force | Out-Null
    " >/dev/null 2>&1 \
        && say "PC will wake at $at (task '$WAKE_TASK')" \
        || say "could not register wake task - PC must stay awake"
    # A wake task is inert unless wake timers are enabled for the active power plan.
    powershell.exe -NoProfile -NonInteractive -Command "powercfg /q SCHEME_CURRENT SUB_SLEEP RTCWAKE" 2>/dev/null \
        | tr -d '\r' | grep -q 'Current AC Power Setting Index: 0x00000001' \
        || say "wake timers are off - powercfg /setacvalueindex SCHEME_CURRENT SUB_SLEEP RTCWAKE 1 && powercfg /setactive SCHEME_CURRENT"
}

clear_wake() {
    [[ "${AUTOPILOT_NOWAKE:-0}" == "1" ]] && return 0
    command -v powershell.exe >/dev/null 2>&1 || return 0
    powershell.exe -NoProfile -NonInteractive -Command \
        "Unregister-ScheduledTask -TaskName '$WAKE_TASK' -Confirm:\$false" >/dev/null 2>&1 || true
}

# Acilista donan session'i dusuren bekci. Ayri pencere gerektirmesin diye
# sarmalayici onu kendi arka planinda tutar, cikarken de temizler.
UNSTICK_PID=""

start_unstick() {
    [[ "${AUTOPILOT_NO_UNSTICK:-0}" == "1" ]] && return 0
    command -v autopilot-unstick >/dev/null 2>&1 || return 0
    autopilot-unstick >>"$HOME/.claude/autopilot-unstick.log" 2>&1 &
    UNSTICK_PID=$!
    say "bekci acik (donan session'lari dusurur) - kapatmak icin AUTOPILOT_NO_UNSTICK=1"
}

stop_unstick() {
    [[ -n "$UNSTICK_PID" ]] && kill "$UNSTICK_PID" 2>/dev/null
    UNSTICK_PID=""
}

main() {
    [[ -f "$RUN" ]] || { echo "run.sh not found: $RUN" >&2; exit 1; }
    trap 'echo ""; say "interrupted"; stop_unstick; clear_wake; exit 130' INT TERM
    trap 'stop_unstick' EXIT
    start_unstick

    local taskfile="" a round=0 left msg until_epoch nap floor
    for a in "$@"; do
        [[ "$a" == *.json && -f "$a" ]] && { taskfile="$a"; break; }
    done

    while true; do
        round=$((round + 1))
        echo ""
        say "=== round $round ==="
        "${RUNNER[@]}" "$RUN" "$@"   # keeps the terminal, so the session is watchable

        if [[ -n "$taskfile" ]] && left=$(remaining_count "$taskfile") && [[ "$left" == "0" ]]; then
            say "task file has nothing left - done."
            exit 0
        fi

        msg=$(limit_probe)
        if [[ -n "$msg" ]]; then
            if until_epoch=$(reset_epoch "$msg"); then
                nap=$(( until_epoch - $(date +%s) + 30 ))
            else
                nap=$RETRY; until_epoch=$(( $(date +%s) + RETRY ))
            fi
            floor=$(( RETRY < 60 ? RETRY : 60 ))
            [[ "$nap" -lt "$floor" ]] && nap=$floor
            say "usage limit: $msg"
            say "waiting ${nap}s"
            schedule_wake "$until_epoch"
            sleep "$nap"
            clear_wake
            continue
        fi

        if [[ -z "$taskfile" ]]; then
            if left=$(queue_next); then
                say "queue still has $left - restarting in ${DELAY}s (Ctrl-C to stop)"
            else
                say "nothing runnable left - done."
                exit 0
            fi
        else
            say "$left requirement(s) left - restarting in ${DELAY}s (Ctrl-C to stop)"
        fi
        sleep "$DELAY"
    done
}

[[ "${BASH_SOURCE[0]}" == "$0" ]] && main "$@"
